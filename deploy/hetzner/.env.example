# TinyZKP backend-recovery host environment.

# deploy.sh exports these from the checked-out revision.
HC_RELEASE_SHA=
HC_RELEASE_REF=
HC_RELEASE_BUILD_URL=

# Existing-customer webhook and operator-run contract billing. There are no
# price IDs or usage-meter settings during recovery.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_EXPECTED_ACCOUNT_ID=acct_xxx
STRIPE_EXPECTED_DISPLAY_NAME="LN Holdings"

# Certified/Fleet annual previews and writes remain unavailable until all four
# values point to owner-only artifacts from the same audited backend release.
# The authorization has its own second Sigstore bundle; contract_billing.py
# verifies the pinned release-backend.yml signer before planning a contract.
TINYZKP_BACKEND_RELEASE_AUTHORIZATION=
TINYZKP_BACKEND_RELEASE_AUTHORIZATION_SHA256=
TINYZKP_BACKEND_RELEASE_AUTHORIZATION_BUNDLE=
TINYZKP_BACKEND_RELEASE_AUTHORIZATION_BUNDLE_SHA256=

# Shared between Cloudflare Pages contact intake and the host webhook. The
# recovery intake is persisted locally and sends no outbound email.
INTERNAL_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# Existing customer/contract records remain backed up off-host.
HC_TENANT_STORE_PATH=/opt/hc-stark/data/tenant_store.sqlite
HC_USAGE_DB_PATH=/opt/hc-stark/data/usage.sqlite
HC_EVALUATION_STORE_PATH=/opt/hc-stark/data/evaluation_applications.sqlite
# Required by contract_billing.py before any operator-authorized Stripe write.
# This ledger is root/operator-owned and intentionally separate from the
# tinyzkp-billing-owned evaluation/application data directory.
# An atomic reservation remains after an interrupted create and must be
# reconciled to the original Stripe object; retries never create a replacement.
TINYZKP_CONTRACT_BILLING_LEDGER_PATH=/var/lib/tinyzkp-private/billing/contract_billing.sqlite
# Production recovery evidence currently authorizes only the reviewed encrypted
# rclone path. HTTP ingest remains unsupported until it has its own fixed-host drill.
HC_BACKUP_REMOTE=tinyzkp-backups-crypt:prod-sqlite
HC_BACKUP_RETENTION_DAYS=30

# Optional billing/backup alert webhook.
ALERT_WEBHOOK_URL=

# Legacy writes must stay disabled.
TINYZKP_MAINTENANCE_MODE=1
TINYZKP_ALLOW_LEGACY_BILLING_WRITE=0
TINYZKP_ALLOW_LEGACY_METER_EVENTS=0
TINYZKP_OUTBOUND_EMAIL_ENABLED=0
TINYZKP_CUSTOMER_EMAILS_ENABLED=0
TINYZKP_ALLOW_CONTRACT_BILLING_WRITE=0
TINYZKP_CONTRACT_SENDER_IDENTITY_CONFIRMED=0
