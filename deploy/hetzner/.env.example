# TinyZKP production environment variables.
# Copy to /opt/hc-stark/.env and fill in real values.

# API keys: "tenant_id:api_key" pairs, comma-separated.
HC_SERVER_API_KEYS=tenant1:CHANGE_ME

# Release identity exposed by /version. deploy/hetzner/deploy.sh fills these
# for normal production deploys; set manually only for custom rollouts.
HC_RELEASE_SHA=
HC_RELEASE_REF=
HC_RELEASE_BUILD_URL=

# Stripe billing.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# Paths (inside container or host).
HC_USAGE_DB_PATH=/opt/hc-stark/data/usage.sqlite
HC_TENANT_STORE_PATH=/opt/hc-stark/data/tenant_store.sqlite
HC_API_KEYS_FILE=/opt/hc-stark/data/api_keys.txt

# State backend and shared-worker cutover.
# Keep HC_SERVER_PROVE_DISPATCH=local until Postgres parity checks pass.
HC_SERVER_PG_URL=
HC_SERVER_PG_TLS=
HC_TENANT_PG_URL=
HC_TENANT_PG_REQUIRED=0
HC_SERVER_AUTH_PG_URL=
HC_SERVER_AUTH_PG_TLS=
HC_SERVER_USAGE_READ_FROM=sqlite
HC_USAGE_SOURCE=sqlite
HC_RATE_LIMIT_PG_URL=
HC_RATE_LIMIT_PG_TLS=
HC_SERVER_JOB_INDEX_SOURCE=sqlite
HC_JOB_INDEX_PG_URL=
HC_JOB_INDEX_PG_TLS=
HC_SERVER_PROVE_DISPATCH=local
HC_JOB_WORKER_INDEX_SOURCE=postgres
HC_JOB_WORKER_USAGE_PG_URL=
HC_JOB_WORKER_LEASE_MS=30000
HC_JOB_WORKER_HEARTBEAT_MS=5000

# Monitoring.
GRAFANA_ADMIN_PASSWORD=changeme

# Prometheus AlertManager email recipient.
ALERT_EMAIL=logan@galenhealth.org

# Email delivery (optional — falls back to Stripe metadata if not set).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=xxx
SMTP_FROM=noreply@tinyzkp.com

# Alerting (optional — Slack/Discord webhook for billing alerts).
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Stripe Meter Event name (must match the Meter configured in Stripe dashboard).
STRIPE_METER_EVENT_NAME=proof_usage

# Internal secret shared between Cloudflare Pages Functions and billing-webhook.
# Must match the INTERNAL_SECRET set in Cloudflare Pages secrets.
INTERNAL_SECRET=CHANGE_ME_TO_A_RANDOM_STRING
