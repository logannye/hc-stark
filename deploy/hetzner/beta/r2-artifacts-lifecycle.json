{
  "rules": [
    {
      "id": "tinyzkp-beta-uploads-24h",
      "enabled": true,
      "conditions": { "prefix": "uploads/" },
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 86400 }
      },
      "abortMultipartUploadsTransition": {
        "condition": { "type": "Age", "maxAge": 86400 }
      }
    },
    {
      "id": "tinyzkp-beta-bundles-90d-maximum",
      "enabled": true,
      "conditions": { "prefix": "bundles/" },
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 7776000 }
      }
    },
    {
      "id": "tinyzkp-beta-abort-incomplete-24h",
      "enabled": true,
      "conditions": { "prefix": "" },
      "abortMultipartUploadsTransition": {
        "condition": { "type": "Age", "maxAge": 86400 }
      }
    }
  ]
}
