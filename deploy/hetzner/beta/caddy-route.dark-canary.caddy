(tinyzkp_beta_write_backend) {
  reverse_proxy 127.0.0.1:8090
}

(tinyzkp_beta_read_backend) {
  # The API itself enforces the immutable GitHub allowlist and API-key tenant.
  # Keeping read routes available here lets the signed production-endpoint CLI
  # run the complete dark lifecycle without a test-only endpoint override.
  reverse_proxy 127.0.0.1:8090
}
