(tinyzkp_security) {
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  }
}

import /etc/caddy/tinyzkp-beta-route.caddy

api.tinyzkp.com {
  import tinyzkp_security

  @beta_write path /v1/auth/* /v1/api-keys* /v1/account /v1/air-packages /v1/uploads /v1/proof-jobs /v1/proof-jobs/*/cancel /v1/billing/checkout-sessions /webhooks/stripe
  handle @beta_write {
    import tinyzkp_beta_write_backend
  }

  @beta_read path /v1/discovery /v1/me /v1/proof-jobs/* /v1/verify /v1/billing/portal-sessions
  handle @beta_read {
    import tinyzkp_beta_read_backend
  }

  handle {
    reverse_proxy 127.0.0.1:8080
  }

  @cors_tinyzkp header Origin https://tinyzkp.com
  @cors_www header Origin https://www.tinyzkp.com
  header @cors_tinyzkp Access-Control-Allow-Origin "https://tinyzkp.com"
  header @cors_www Access-Control-Allow-Origin "https://www.tinyzkp.com"
  header {
    Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
    Access-Control-Allow-Headers "Authorization, Content-Type, Idempotency-Key"
  }
}

mcp.tinyzkp.com {
  import tinyzkp_security
  redir /favicon.svg https://tinyzkp.com/favicon.svg permanent
  redir /favicon.ico https://tinyzkp.com/favicon.svg permanent

  @cors_tinyzkp header Origin https://tinyzkp.com
  @cors_www header Origin https://www.tinyzkp.com
  header @cors_tinyzkp Access-Control-Allow-Origin "https://tinyzkp.com"
  header @cors_www Access-Control-Allow-Origin "https://www.tinyzkp.com"
  header {
    Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Access-Control-Allow-Headers "Content-Type, Accept, Mcp-Session-Id"
    Access-Control-Expose-Headers "Mcp-Session-Id"
  }

  reverse_proxy 127.0.0.1:3001
}

webhook.tinyzkp.com {
  import tinyzkp_security

  @stripe_webhook path /webhook
  handle @stripe_webhook {
    reverse_proxy 127.0.0.1:5001
  }

  @contact_intake path /send-contact
  handle @contact_intake {
    reverse_proxy 127.0.0.1:5001
  }

  @contact_readiness path /contact-readiness
  handle @contact_readiness {
    reverse_proxy 127.0.0.1:5001
  }

  @webhook_health path /health
  handle @webhook_health {
    reverse_proxy 127.0.0.1:5001
  }

  respond 404
}
