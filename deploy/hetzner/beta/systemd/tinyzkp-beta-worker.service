[Unit]
Description=TinyZKP paid public-beta proving worker
Requires=docker.service wg-quick@wg0.service
After=docker.service wg-quick@wg0.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/tinyzkp/deploy/hetzner/beta
EnvironmentFile=/etc/tinyzkp/worker/compose.env
ExecStart=/usr/bin/docker compose -f docker-compose.worker.yml up --no-color --abort-on-container-exit --exit-code-from worker
ExecStop=/usr/bin/docker compose -f docker-compose.worker.yml down --timeout 90
Restart=on-failure
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
