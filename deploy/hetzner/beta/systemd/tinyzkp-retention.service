[Unit]
Description=TinyZKP R2 and database retention sweeper
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/tinyzkp/deploy/hetzner/beta
EnvironmentFile=/etc/tinyzkp/beta/compose.env
ExecStart=/usr/bin/docker compose -f docker-compose.api.yml run --rm --no-deps --entrypoint /usr/local/bin/hc-beta-retention beta-ops
