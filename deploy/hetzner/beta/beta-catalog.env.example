# Load only for the idempotent Stripe beta-catalog command; chmod 0600.
HC_RELEASE_SHA=REPLACE_FULL_GIT_SHA
STRIPE_SECRET_KEY=sk_live_REPLACE
TINYZKP_ALLOW_BETA_CATALOG_WRITE=1
TINYZKP_STRIPE_ACCOUNT_ID=acct_REPLACE
TINYZKP_STRIPE_DISPLAY_NAME=REPLACE_EXACT_ACCOUNT_NAME
TINYZKP_BETA_CATALOG_AUTHORIZATION=/run/secrets/dark-canary-authorization.json
TINYZKP_BETA_CATALOG_AUTHORIZATION_BUNDLE=/run/secrets/dark-canary-authorization.sigstore.json
TINYZKP_BETA_CATALOG_SIGNING_IDENTITY_REGEXP=^https://github\.com/logannye/hc-stark/\.github/workflows/public-beta-candidate\.yml@refs/heads/main$
TINYZKP_BETA_CATALOG_SIGNING_ISSUER=https://token.actions.githubusercontent.com
TINYZKP_COSIGN_BIN=/usr/local/bin/cosign
