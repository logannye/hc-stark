[global]
repo1-type=s3
repo1-s3-endpoint=REPLACE_WITH_R2_ENDPOINT
repo1-s3-bucket=REPLACE_WITH_PRIVATE_BACKUP_BUCKET
repo1-s3-region=auto
repo1-s3-uri-style=path
repo1-s3-key=REPLACE_WITH_SCOPED_ACCESS_KEY
repo1-s3-key-secret=REPLACE_WITH_SCOPED_SECRET
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_FROM_OWNER_ONLY_SECRET
repo1-retention-full=4
repo1-retention-diff=30
repo1-bundle=y
repo1-block=y
start-fast=y
process-max=2
archive-async=y
spool-path=/var/lib/postgresql/data/pgbackrest-spool
log-level-console=info
log-level-file=detail

[tinyzkp-beta]
pg1-path=/var/lib/postgresql/data/pgdata
pg1-port=5432
pg1-database=tinyzkp_beta
pg1-user=tinyzkp_beta
