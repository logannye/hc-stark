FROM rust:1.95-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS build
ARG HC_RELEASE_SHA
WORKDIR /src
COPY . .
RUN cargo build --locked --release -p hc-beta-api --bin hc-beta-api --bin hc-beta-reconcile --bin hc-beta-refund --bin hc-beta-retention
RUN curl -fsSLo /tmp/cosign https://github.com/sigstore/cosign/releases/download/v2.4.3/cosign-linux-amd64 \
 && echo 'caaad125acef1cb81d58dcdc454a1e429d09a750d1e9e2b3ed1aed8964454708  /tmp/cosign' | sha256sum -c - \
 && chmod 0755 /tmp/cosign

FROM debian:12.11-slim@sha256:b1a741487078b369e78119849663d7f1a5341ef2768798f7b7406c4240f86aef
ARG HC_RELEASE_SHA
LABEL org.opencontainers.image.revision=$HC_RELEASE_SHA
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --home /nonexistent --shell /usr/sbin/nologin tinyzkp
COPY --from=build /src/target/release/hc-beta-api /usr/local/bin/hc-beta-api
COPY --from=build /src/target/release/hc-beta-reconcile /usr/local/bin/hc-beta-reconcile
COPY --from=build /src/target/release/hc-beta-refund /usr/local/bin/hc-beta-refund
COPY --from=build /src/target/release/hc-beta-retention /usr/local/bin/hc-beta-retention
COPY --from=build /tmp/cosign /usr/local/bin/cosign
USER 10001:10001
EXPOSE 8090 8091
ENTRYPOINT ["/usr/local/bin/hc-beta-api"]
