# Copy to an owner-only directory outside the checkout and chmod 0600.
HC_RELEASE_SHA=REPLACE_FULL_GIT_SHA
TINYZKP_DATABASE_URL=postgresql://tinyzkp_beta:REPLACE_PASSWORD@pgbouncer:5432/tinyzkp_beta
TINYZKP_BETA_EXPOSURE=dark_canary
TINYZKP_BETA_WRITES_ENABLED=1
TINYZKP_OPERATOR_GITHUB_IDS=REPLACE_GITHUB_NUMERIC_ID
TINYZKP_GITHUB_CLIENT_ID=REPLACE
TINYZKP_GITHUB_CLIENT_SECRET=REPLACE
TINYZKP_GITHUB_CALLBACK_URL=https://tinyzkp.com/v1/auth/github/callback
TINYZKP_DASHBOARD_URL=https://tinyzkp.com
TINYZKP_OAUTH_CIPHER_KEY=REPLACE_BASE64_32_BYTES
TINYZKP_SECRET_PEPPER=REPLACE_BASE64_AT_LEAST_32_BYTES
TINYZKP_R2_ARTIFACT_BUCKET=REPLACE_PRIVATE_BUCKET
TINYZKP_R2_ENDPOINT=https://REPLACE_ACCOUNT.r2.cloudflarestorage.com
TINYZKP_R2_REGION=auto
AWS_ACCESS_KEY_ID=REPLACE_SCOPED_ARTIFACT_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_SCOPED_ARTIFACT_SECRET
STRIPE_SECRET_KEY=REPLACE_BETA_ACCOUNT_KEY
TINYZKP_STRIPE_WEBHOOK_SECRET=REPLACE
TINYZKP_STRIPE_PORTAL_CONFIGURATION=REPLACE_BETA_PORTAL_CONFIG
TINYZKP_STRIPE_PRICE_MAP_JSON={"builder_monthly":"price_REPLACE","pro_monthly":"price_REPLACE","scale_beta_monthly":"price_REPLACE","topup_25":"price_REPLACE","topup_100":"price_REPLACE","topup_500":"price_REPLACE"}
TINYZKP_PUBLIC_BETA_RELEASE_AUTHORIZATION=/run/secrets/public-beta-authorization.json
TINYZKP_PUBLIC_BETA_RELEASE_AUTHORIZATION_SHA256=REPLACE_ONLY_FOR_PUBLIC_MODE
TINYZKP_PUBLIC_BETA_RELEASE_AUTHORIZATION_BUNDLE=/run/secrets/public-beta-authorization.sigstore.json
TINYZKP_PUBLIC_BETA_SIGNING_IDENTITY_REGEXP=^https://github\.com/logannye/hc-stark/\.github/workflows/public-beta-release\.yml@refs/tags/public-beta-v[^/]+$
TINYZKP_PUBLIC_BETA_SIGNING_ISSUER=https://token.actions.githubusercontent.com
