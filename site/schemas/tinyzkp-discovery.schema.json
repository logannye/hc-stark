{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyzkp.com/schemas/tinyzkp-discovery.schema.json",
  "title": "TinyZKP Discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "name",
    "canonical_url",
    "generated_at",
    "positioning",
    "primary_actions",
    "commercial_routes",
    "machine_readable_assets",
    "trust_boundaries",
    "support"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": { "type": "string" },
    "canonical_url": { "type": "string", "format": "uri" },
    "generated_at": { "type": "string", "format": "date" },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["short", "description", "primary_audiences", "best_first_workflows", "not_a_default_fit"],
      "properties": {
        "short": { "type": "string" },
        "description": { "type": "string" },
        "primary_audiences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "best_first_workflows": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "not_a_default_fit": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "primary_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url", "audience"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "audience": { "type": "string" }
        }
      }
    },
    "commercial_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "best_for"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "best_for": { "type": "string" }
        }
      }
    },
    "machine_readable_assets": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" },
      "minProperties": 1
    },
    "trust_boundaries": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact", "security", "status"],
      "properties": {
        "contact": { "type": "string", "format": "uri" },
        "security": { "type": "string", "format": "uri" },
        "status": { "type": "string", "format": "uri" }
      }
    }
  }
}
