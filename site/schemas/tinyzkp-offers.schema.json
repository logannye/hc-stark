{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyzkp.com/schemas/tinyzkp-offers.schema.json",
  "title": "TinyZKP Agent-Readable Offers",
  "type": "object",
  "required": [
    "name",
    "generated_at",
    "canonical_url",
    "currency",
    "positioning",
    "default_public_product",
    "human_confirmation_required",
    "human_confirmation_language",
    "verification",
    "plans",
    "commercial_packages",
    "recommendation_rules",
    "checkout_safety",
    "data_boundaries",
    "support",
    "machine_readable_assets"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": { "type": "string" },
    "generated_at": { "type": "string" },
    "canonical_url": { "type": "string", "format": "uri" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "positioning": { "type": "string" },
    "default_public_product": { "type": "string" },
    "human_confirmation_required": { "type": "boolean" },
    "human_confirmation_language": { "type": "string" },
    "verification": {
      "type": "object",
      "required": ["price", "unit", "url", "note"],
      "properties": {
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "base_monthly",
          "included_receipts_per_month",
          "prove_requests_per_minute",
          "concurrent_jobs",
          "monthly_spend_cap",
          "checkout_url",
          "best_for",
          "agent_recommend_when"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "base_monthly": { "type": "number" },
          "included_receipts_per_month": { "type": "integer", "minimum": 0 },
          "prove_requests_per_minute": { "type": "integer", "minimum": 0 },
          "concurrent_jobs": { "type": "integer", "minimum": 0 },
          "monthly_spend_cap": { "type": ["number", "null"] },
          "checkout_url": { "type": "string", "format": "uri" },
          "best_for": { "type": "string" },
          "agent_recommend_when": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "commercial_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "price", "unit", "url", "best_for"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "price": { "type": ["number", "string"] },
          "unit": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "checkout_url": { "type": "string", "format": "uri" },
          "best_for": { "type": "string" },
          "credit_policy": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "recommendation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["if", "recommend", "reason"],
        "properties": {
          "if": { "type": "string" },
          "recommend": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "checkout_safety": {
      "type": "object",
      "required": [
        "must_confirm_before_checkout",
        "checkout_urls_are_entrypoints",
        "payment_collection",
        "billing_portal",
        "cancellation"
      ],
      "properties": {
        "must_confirm_before_checkout": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "checkout_urls_are_entrypoints": { "type": "boolean" },
        "payment_collection": { "type": "string" },
        "billing_portal": { "type": "string", "format": "uri" },
        "cancellation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "data_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "support": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "machine_readable_assets": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
