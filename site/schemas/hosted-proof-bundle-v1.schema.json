        "proof_digest_hex": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ReleaseProvenanceV1"
        },
        "public_inputs": {
          "$ref": "#/$defs/PublicInputsV1"
        },
        "public_inputs_digest_hex": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "trace_manifest": {
          "$ref": "#/$defs/TraceManifestV1"
        },
        "trace_manifest_digest_hex": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "air",
        "air_digest_hex",
        "trace_manifest",
        "trace_manifest_digest_hex",
        "public_inputs",
        "public_inputs_digest_hex",
        "proof_base64url",
        "proof_digest_hex",
        "provenance"
      ]
