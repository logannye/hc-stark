    "PublicInputSlotV1": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "PublicInputsV1": {
      "type": "object",
      "properties": {
        "air_digest_hex": {
          "type": "string"
