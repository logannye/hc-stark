        },
        "expected_verifier": {
          "type": "string"
        },
        "expressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AirExpressionV1"
          }
        },
        "field": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "public_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicInputSlotV1"
          }
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
