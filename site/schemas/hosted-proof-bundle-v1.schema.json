        "scratch_high_water_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total_read_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total_write_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "wall_time_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
