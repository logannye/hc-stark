        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "air_digest_hex",
        "values"
      ]
    },
    "ReleaseProvenanceV1": {
      "type": "object",
      "properties": {
        "dependency_profile": {
          "type": "string"
        },
        "proof_serializer": {
          "type": "string"
