{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostedProofBundleV1",
  "type": "object",
  "properties": {
    "charge_millicredits": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "official_verification": {
      "type": "boolean"
    },
    "proof": {
      "$ref": "#/$defs/AirProofBundleV1"
    },
    "resource_report": {
      "$ref": "#/$defs/HostedResourceReportV1"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof",
    "resource_report",
    "charge_millicredits",
    "official_verification"
  ],
