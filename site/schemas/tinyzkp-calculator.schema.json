{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyzkp.com/schemas/tinyzkp-calculator.schema.json",
  "title": "TinyZKP Calculator Metadata",
  "type": "object",
  "required": ["name", "url", "generated_at", "currency", "source_pricing", "summary", "inputs", "recommendation_rules", "sample_estimates", "links"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "generated_at": { "type": "string" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "source_pricing": { "type": "string", "format": "uri" },
    "summary": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["workflow", "volume", "trace_bands", "external_verifier_visible"],
      "properties": {
        "workflow": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "guidance"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "guidance": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "volume": {
          "type": "object",
          "required": ["unit", "min", "max"],
          "properties": {
            "unit": { "type": "string" },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "trace_bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "representative_trace_steps"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "representative_trace_steps": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "external_verifier_visible": {
          "type": "object",
          "required": ["type", "default", "guidance"],
          "properties": {
            "type": { "type": "string" },
            "default": { "type": "boolean" },
            "guidance": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "recommendation_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "sample_estimates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["workflow", "volume", "trace_band", "external_verifier_visible", "recommended", "estimated_monthly", "effective_cost_per_receipt"],
        "properties": {
          "workflow": { "type": "string" },
          "volume": { "type": "integer", "minimum": 1 },
          "trace_band": { "type": "string" },
          "external_verifier_visible": { "type": "boolean" },
          "recommended": { "type": "string" },
          "estimated_monthly": { "type": "number" },
          "effective_cost_per_receipt": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" }
    }
  },
  "additionalProperties": false
}
