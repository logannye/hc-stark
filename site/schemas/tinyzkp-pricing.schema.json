{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyzkp.com/schemas/tinyzkp-pricing.schema.json",
  "title": "TinyZKP Pricing Metadata",
  "type": "object",
  "required": ["name", "url", "generated_at", "currency", "summary", "verification", "plans", "proof_rate_bands", "compute", "billing_rules", "buyer_guidance", "links"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "generated_at": { "type": "string" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "summary": { "type": "string" },
    "verification": {
      "type": "object",
      "required": ["price", "unit", "note"],
      "properties": {
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "base_monthly", "included_receipts_per_month", "prove_requests_per_minute", "concurrent_jobs", "monthly_spend_cap", "discount_percent", "checkout_url", "best_for"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "base_monthly": { "type": "number" },
          "included_receipts_per_month": { "type": "integer", "minimum": 0 },
          "prove_requests_per_minute": { "type": "integer", "minimum": 0 },
          "concurrent_jobs": { "type": "integer", "minimum": 0 },
          "monthly_spend_cap": { "type": ["number", "null"] },
          "discount_percent": { "type": "number", "minimum": 0 },
          "checkout_url": { "type": "string", "format": "uri" },
          "best_for": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "proof_rate_bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "trace_steps", "developer", "pro", "scale", "compute"],
        "properties": {
          "id": { "type": "string" },
          "trace_steps": {
            "type": "object",
            "required": ["min", "max_exclusive", "label"],
            "properties": {
              "min": { "type": "integer", "minimum": 0 },
              "max_exclusive": { "type": ["integer", "null"] },
              "label": { "type": "string" }
            },
            "additionalProperties": false
          },
          "developer": { "type": "number" },
          "pro": { "type": "number" },
          "scale": { "type": "number" },
          "compute": {
            "type": "object",
            "required": ["formula", "display"],
            "properties": {
              "formula": { "type": "string" },
              "display": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "compute": { "type": "object" },
    "commercial_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "price", "unit", "checkout_url", "best_for", "notes"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "price": { "type": ["number", "string"] },
          "unit": { "type": "string" },
          "checkout_url": { "type": "string", "format": "uri" },
          "best_for": { "type": "string" },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "billing_rules": { "type": "object" },
    "buyer_guidance": { "type": "object" },
    "links": { "type": "object" }
  },
  "additionalProperties": false
}
