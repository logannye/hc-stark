{
  "$defs": {
    "SelectedModeV1": {
      "enum": [
        "conventional",
        "bounded"
      ],
      "type": "string"
    }
  },
  "$id": "https://tinyzkp.com/schemas/policy-baseline-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_modes": {
      "items": {
        "$ref": "#/$defs/SelectedModeV1"
      },
      "type": "array"
    },
    "maximum_peak_resident_bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "maximum_scratch_high_water_bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "maximum_wall_time_millis": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "maximum_peak_resident_bytes",
    "maximum_scratch_high_water_bytes",
    "allowed_modes"
  ],
  "title": "PolicyBaselineV1",
  "type": "object"
}
