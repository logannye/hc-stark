{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyzkp.com/schemas/tinyzkp-integrations.schema.json",
  "title": "TinyZKP Integrations Metadata",
  "type": "object",
  "required": [
    "name",
    "url",
    "generated_at",
    "summary",
    "default_guidance",
    "surfaces",
    "related_assets"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "generated_at": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "default_guidance": {
      "type": "object",
      "required": ["agent_workflows", "backend_workflows", "recipient_verification", "large_traces", "data_boundary"],
      "properties": {
        "agent_workflows": { "type": "string" },
        "backend_workflows": { "type": "string" },
        "recipient_verification": { "type": "string" },
        "large_traces": { "type": "string" },
        "data_boundary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "best_for", "docs", "returns"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "best_for": { "type": "string" },
          "entrypoint": { "type": "string", "format": "uri" },
          "docs": { "type": "string", "format": "uri" },
          "install": { "type": "string" },
          "openapi": { "type": "string", "format": "uri" },
          "pricing": { "type": "string", "format": "uri" },
          "returns": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "related_assets": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" }
    }
  },
  "additionalProperties": false
}
