{
  "$defs": {
    "CompatibilityLimitsV1": {
      "additionalProperties": false,
      "properties": {
        "maximum_constraint_degree": {
          "const": 3,
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "maximum_rows": {
          "const": 16777216,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maximum_trace_width": {
          "const": 256,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "minimum_rows": {
          "const": 1024,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "minimum_rows",
        "maximum_rows",
        "maximum_trace_width",
        "maximum_constraint_degree"
      ],
      "type": "object"
    },
    "PlatformV1": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "const": "x86_64",
          "enum": [
            "x86_64",
            "aarch64",
            "other"
          ],
          "type": "string"
        },
        "operating_system": {
          "const": "linux",
          "enum": [
            "linux",
            "macos",
            "windows",
            "other"
          ],
          "type": "string"
        }
      },
      "required": [
        "operating_system",
        "architecture"
      ],
      "type": "object"
    },
    "ReleaseIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "compatibility_profile": {
          "const": "tinyzkp-p3-goldilocks-v1",
          "type": "string"
        },
        "engine_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "engine_source_identity": {
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._:+/-]{1,256}$",
          "type": "string"
        },
        "guard_source_identity": {
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._:+/-]{1,256}$",
          "type": "string"
        },
        "guard_version": {
          "type": "string"
        },
        "qualification": {
          "type": "string"
        },
        "release_identity": {
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._:+/-]{1,256}$",
          "type": "string"
        }
      },
      "required": [
        "guard_version",
        "guard_source_identity",
        "engine_source_identity",
        "engine_artifact_sha256",
        "release_identity",
        "compatibility_profile",
        "qualification"
      ],
      "type": "object"
    }
  },
  "$id": "https://tinyzkp.com/schemas/compatibility-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "declarative_operators": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "explicitly_unsupported": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "extension_degree": {
      "const": 2,
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "field": {
      "const": "goldilocks",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/CompatibilityLimitsV1"
    },
    "permutation": {
      "const": "poseidon2_width_8",
      "type": "string"
    },
    "platform": {
      "$ref": "#/$defs/PlatformV1"
    },
    "plonky3_version": {
      "const": "0.6.1",
      "type": "string"
    },
    "profile": {
      "const": "tinyzkp-p3-goldilocks-v1",
      "type": "string"
    },
    "release": {
      "$ref": "#/$defs/ReleaseIdentityV1"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "verifier": {
      "const": "p3_uni_stark_0.6.1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "platform",
    "plonky3_version",
    "field",
    "extension_degree",
    "permutation",
    "verifier",
    "declarative_operators",
    "limits",
    "explicitly_unsupported",
    "release"
  ],
  "title": "CompatibilityManifestV1",
  "type": "object"
}
