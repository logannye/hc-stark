{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyzkp.com/schemas/tinyzkp-enterprise.schema.json",
  "title": "TinyZKP Enterprise Metadata",
  "type": "object",
  "required": [
    "name",
    "url",
    "generated_at",
    "summary",
    "offer",
    "best_fit",
    "review_first",
    "enterprise_review_topics",
    "rollout",
    "not_claimed_by_default",
    "qualification_inputs",
    "procurement_assets",
    "links"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "generated_at": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "offer": {
      "type": "object",
      "required": ["primary", "entrypoint", "commercial_model"],
      "properties": {
        "primary": { "type": "string" },
        "entrypoint": { "type": "string" },
        "commercial_model": { "type": "string" }
      },
      "additionalProperties": false
    },
    "best_fit": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "review_first": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "enterprise_review_topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["area", "topics"],
        "properties": {
          "area": { "type": "string" },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "commercial_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "commercial_model", "best_for"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "commercial_model": { "type": "string" },
          "best_for": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "rollout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase", "goal"],
        "properties": {
          "phase": { "type": "string" },
          "goal": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "not_claimed_by_default": {
      "type": "array",
      "items": { "type": "string" }
    },
    "qualification_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "procurement_assets": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" }
    },
    "links": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" }
    }
  },
  "additionalProperties": false
}
