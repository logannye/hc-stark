{
  "$defs": {
    "ArtifactDescriptorV1": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "GuardReleaseChangeClassV1": {
      "description": "Software change class for a newly minted Guard release channel.\n\nSite, legal, and pricing-only changes do not mint a software channel and\nare deliberately absent from this closed wire vocabulary.",
      "enum": [
        "proof_critical",
        "guard_package_only"
      ],
      "type": "string"
    },
    "MerchantCatalogIdentityV1": {
      "additionalProperties": false,
      "description": "Exact Lemon Squeezy catalog identifiers bound into a qualified release.\nRuntime entitlement transport remains behind Guard's provider adapter.",
      "properties": {
        "annual_variant_id": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "type": "string"
        },
        "entitlement_mode": {
          "const": "lemon_squeezy_subscription_license_keys",
          "type": "string"
        },
        "merchant": {
          "const": "lemon_squeezy",
          "type": "string"
        },
        "monthly_variant_id": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "type": "string"
        },
        "store_id": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "type": "string"
        }
      },
      "required": [
        "merchant",
        "entitlement_mode",
        "store_id",
        "product_id",
        "monthly_variant_id",
        "annual_variant_id"
      ],
      "type": "object"
    }
  },
  "$id": "https://tinyzkp.com/schemas/guard-channel-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "prior_qualified_release_identity": {
              "type": "string"
            },
            "prior_release_index_sha256": {
              "type": "string"
            }
          },
          "required": [
            "prior_qualified_release_identity",
            "prior_release_index_sha256"
          ]
        },
        {
          "properties": {
            "prior_qualified_release_identity": {
              "type": "null"
            },
            "prior_release_index_sha256": {
              "type": "null"
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "release_change_class": {
            "const": "guard_package_only"
          }
        },
        "required": [
          "release_change_class"
        ]
      },
      "then": {
        "properties": {
          "prior_qualified_release_identity": {
            "type": "string"
          },
          "prior_release_index_sha256": {
            "type": "string"
          }
        },
        "required": [
          "prior_qualified_release_identity",
          "prior_release_index_sha256"
        ]
      }
    }
  ],
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactDescriptorV1"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "compatibility_profile": {
      "const": "tinyzkp-p3-goldilocks-v1",
      "type": "string"
    },
    "engine_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "engine_source_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "eula_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "guard_source_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "guard_version": {
      "type": "string"
    },
    "merchant_catalog": {
      "$ref": "#/$defs/MerchantCatalogIdentityV1"
    },
    "oci_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "prior_qualified_release_identity": {
      "description": "Qualified predecessor for a later release. Both predecessor fields are\n`None` only for the first proof-critical GA channel.",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._:+/-]{1,256}$",
      "type": [
        "string",
        "null"
      ]
    },
    "prior_release_index_sha256": {
      "description": "SHA-256 of the signed release index that established the predecessor.\nThis is present exactly when `prior_qualified_release_identity` is.",
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "public_candidate_authorization_commit": {
      "description": "Public repository commit whose generated authorization permitted this\nexact private candidate build. Promotion evidence is necessarily a\nlater public commit, so this identity prevents either commit or the\npublic release tag from being substituted after the build.",
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "qualification": {
      "type": "string"
    },
    "release_change_class": {
      "$ref": "#/$defs/GuardReleaseChangeClassV1"
    },
    "release_date": {
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "type": "string"
    },
    "release_identity": {
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._:+/-]{1,256}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "schemas": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxProperties": 13,
      "minProperties": 13,
      "propertyNames": {
        "enum": [
          "job-manifest-v1.schema.json",
          "doctor-report-v1.schema.json",
          "compatibility-report-v1.schema.json",
          "reason-v1.schema.json",
          "error-envelope-v1.schema.json",
          "progress-event-v1.schema.json",
          "job-result-v1.schema.json",
          "support-report-v1.schema.json",
          "job-inspect-result-v1.schema.json",
          "guard-channel-v1.schema.json",
          "guard-release-index-v1.schema.json",
          "policy-baseline-v1.schema.json",
          "compatibility-manifest-v1.schema.json"
        ]
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "guard_version",
    "release_identity",
    "release_change_class",
    "public_candidate_authorization_commit",
    "guard_source_sha",
    "engine_source_sha",
    "engine_artifact_sha256",
    "artifacts",
    "oci_digest",
    "schemas",
    "eula_sha256",
    "release_date",
    "compatibility_profile",
    "merchant_catalog",
    "qualification"
  ],
  "title": "GuardChannelV1",
  "type": "object"
}
