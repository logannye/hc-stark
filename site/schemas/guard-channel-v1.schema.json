{
  "$id": "https://tinyzkp.com/schemas/guard-channel-v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ArtifactDescriptorV1": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    }
  },
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/definitions/ArtifactDescriptorV1"
      },
      "type": "array"
    },
    "compatibility_profile": {
      "const": "tinyzkp-p3-goldilocks-v1",
      "type": "string"
    },
    "engine_artifact_sha256": {
      "type": "string"
    },
    "engine_source_sha": {
      "type": "string"
    },
    "eula_sha256": {
      "type": "string"
    },
    "guard_source_sha": {
      "type": "string"
    },
    "guard_version": {
      "type": "string"
    },
    "oci_digest": {
      "type": "string"
    },
    "qualification": {
      "type": "string"
    },
    "release_date": {
      "type": "string"
    },
    "release_identity": {
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "schemas": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "artifacts",
    "compatibility_profile",
    "engine_artifact_sha256",
    "engine_source_sha",
    "eula_sha256",
    "guard_source_sha",
    "guard_version",
    "oci_digest",
    "qualification",
    "release_date",
    "release_identity",
    "schema_version",
    "schemas"
  ],
  "title": "GuardChannelV1",
  "type": "object"
}
