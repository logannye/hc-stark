{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchmarkReportV1",
  "type": "object",
  "properties": {
    "benchmark_session_id": {
      "type": "string",
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[0-9a-f]{32}$"
    },
    "cgroup_peak_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 1
    },
    "cpu_seconds": {
      "type": "number",
      "format": "double"
    },
    "dependency_profile": {
      "type": "string"
    },
    "exact_command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_status": {
      "type": "integer",
      "format": "int32"
    },
    "failure_diagnostic": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "hardware": {
      "type": "string",
      "minLength": 1
    },
    "logical_cpu_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1
    },
    "mode": {
      "$ref": "#/$defs/BenchmarkMode"
    },
    "normalized_manifest_digest_hex": {
      "type": "string"
    },
    "normalized_manifest_path": {
      "type": "string"
    },
    "operating_system": {
      "type": "string",
      "minLength": 1
    },
    "peak_rss_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 1
    },
    "preflight_estimate": {
      "$ref": "#/$defs/ResourceEstimate"
    },
    "proof_size_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 1
    },
    "read_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "release_sha": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "scope": {
      "type": "string"
    },
    "scratch_high_water_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "storage": {
      "type": "string",
      "minLength": 1
    },
    "storage_device": {
      "type": "string",
      "minLength": 1
    },
    "storage_is_nvme": {
      "type": "boolean"
    },
    "storage_is_rotational": {
      "type": "boolean"
    },
    "total_memory_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 1
    },
    "verification_succeeded": {
      "type": "boolean"
    },
    "verification_time_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "wall_time_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 1
    },
    "workload_manifest_digest_hex": {
      "type": "string"
    },
    "write_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "mode",
    "benchmark_session_id",
    "hardware",
    "logical_cpu_count",
    "total_memory_bytes",
    "operating_system",
    "storage",
    "storage_device",
    "storage_is_rotational",
    "storage_is_nvme",
    "release_sha",
    "dependency_profile",
    "exact_command",
    "normalized_manifest_path",
    "workload_manifest_digest_hex",
    "normalized_manifest_digest_hex",
    "preflight_estimate",
    "cpu_seconds",
    "wall_time_ms",
    "peak_rss_bytes",
    "cgroup_peak_bytes",
    "scratch_high_water_bytes",
    "read_bytes",
    "write_bytes",
    "proof_size_bytes",
    "verification_time_ms",
    "verification_succeeded",
    "exit_status"
  ],
  "$defs": {
    "BenchmarkMode": {
      "type": "string",
      "enum": [
        "baseline",
        "bounded"
      ]
    },
    "PhaseEstimate": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string"
        },
        "read_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "write_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "phase",
        "read_bytes",
        "write_bytes"
      ]
    },
    "ResourceEstimate": {
      "type": "object",
      "properties": {
        "peak_resident_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PhaseEstimate"
          }
        },
        "scratch_high_water_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total_read_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total_write_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "peak_resident_bytes",
        "scratch_high_water_bytes",
        "total_read_bytes",
        "total_write_bytes",
        "phases"
      ]
    }
  }
}
