{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyzkp.com/schemas/tinyzkp-changelog.schema.json",
  "title": "TinyZKP Changelog and Release Policy Metadata",
  "type": "object",
  "required": [
    "name",
    "url",
    "generated_at",
    "summary",
    "current_public_release",
    "release_policy",
    "surface_policy",
    "release_identity",
    "links"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "generated_at": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "current_public_release": {
      "type": "object",
      "required": ["id", "date", "status", "theme", "product_boundary", "surfaces", "highlights", "compatibility_notes"],
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "theme": { "type": "string" },
        "product_boundary": { "type": "string" },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "highlights": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "compatibility_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "release_policy": {
      "type": "object",
      "required": ["additive_changes", "breaking_or_sensitive_changes", "normal_requirements", "emergency_exception"],
      "properties": {
        "additive_changes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "breaking_or_sensitive_changes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "normal_requirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "emergency_exception": { "type": "string" }
      },
      "additionalProperties": false
    },
    "surface_policy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["surface", "metadata", "breaking_change_examples", "required_artifacts"],
        "properties": {
          "surface": { "type": "string" },
          "metadata": { "type": "string", "format": "uri" },
          "breaking_change_examples": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_artifacts": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "release_identity": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" }
    },
    "links": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" }
    }
  },
  "additionalProperties": false
}
