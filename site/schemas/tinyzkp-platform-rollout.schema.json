{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyzkp.com/schemas/tinyzkp-platform-rollout.schema.json",
  "title": "TinyZKP Platform Rollout Metadata",
  "type": "object",
  "required": [
    "name",
    "url",
    "generated_at",
    "summary",
    "audience",
    "commercial_model",
    "offer",
    "rollout_phases",
    "distribution_hooks",
    "technical_requirements",
    "success_metrics",
    "links"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "generated_at": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "commercial_model": {
      "type": "object",
      "required": ["starting_package", "recommended_first_step", "usage_model", "verification"],
      "properties": {
        "starting_package": { "type": "string" },
        "recommended_first_step": { "type": "string" },
        "usage_model": { "type": "string" },
        "verification": { "type": "string" }
      },
      "additionalProperties": false
    },
    "offer": {
      "type": "object",
      "required": ["primary_outcome", "included", "not_included_by_default"],
      "properties": {
        "primary_outcome": { "type": "string" },
        "included": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "not_included_by_default": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "rollout_phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase", "goal"],
        "properties": {
          "phase": { "type": "string" },
          "goal": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "distribution_hooks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "technical_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "success_metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "links": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" }
    }
  },
  "additionalProperties": false
}
