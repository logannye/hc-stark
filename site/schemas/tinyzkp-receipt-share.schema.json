{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyzkp.com/schemas/tinyzkp-receipt-share.schema.json",
  "title": "TinyZKP Receipt Share Contract",
  "type": "object",
  "required": [
    "$schema",
    "canonical_url",
    "status",
    "verifier_url",
    "share_url_template",
    "fragment",
    "proof_shape",
    "attribution",
    "data_boundaries",
    "related_assets"
  ],
  "properties": {
    "$schema": {
      "const": "https://tinyzkp.com/schemas/tinyzkp-receipt-share.schema.json"
    },
    "name": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "canonical_url": {
      "const": "https://tinyzkp.com/.well-known/tinyzkp-receipt-share.json"
    },
    "status": {
      "enum": [
        "live",
        "preview"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "verifier_url": {
      "const": "https://tinyzkp.com/verify"
    },
    "share_url_template": {
      "type": "string",
      "pattern": "^https://tinyzkp\\.com/verify\\?"
    },
    "fragment": {
      "type": "object",
      "required": [
        "parameter",
        "encoding",
        "decoded_format",
        "max_encoded_chars",
        "browser_network_boundary"
      ],
      "properties": {
        "parameter": {
          "const": "proof"
        },
        "encoding": {
          "const": "base64url"
        },
        "decoded_format": {
          "const": "utf-8 JSON"
        },
        "max_encoded_chars": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 200000
        },
        "browser_network_boundary": {
          "type": "string"
        }
      }
    },
    "proof_shape": {
      "type": "object"
    },
    "attribution": {
      "type": "object",
      "required": [
        "required_source",
        "recommended_mediums",
        "recommended_intent",
        "conversion_ctas",
        "events"
      ]
    },
    "data_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "human_and_agent_guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_assets": {
      "type": "object"
    }
  }
}
