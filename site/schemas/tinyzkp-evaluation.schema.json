{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyzkp.com/schemas/tinyzkp-evaluation.schema.json",
  "title": "TinyZKP Evaluation Metadata",
  "type": "object",
  "required": [
    "name",
    "url",
    "generated_at",
    "summary",
    "evaluation_positioning",
    "evaluation_steps",
    "stakeholders",
    "decision_criteria",
    "roi_drivers",
    "go_no_go_gates",
    "evidence_to_collect",
    "recommended_paths",
    "links"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "generated_at": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "evaluation_positioning": {
      "type": "object",
      "required": ["primary_question", "best_for", "not_for"],
      "properties": {
        "primary_question": { "type": "string" },
        "best_for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "not_for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "evaluation_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase", "action", "output"],
        "properties": {
          "phase": { "type": "string" },
          "action": { "type": "string" },
          "output": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "stakeholders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "cares_about", "assets"],
        "properties": {
          "role": { "type": "string" },
          "cares_about": { "type": "string" },
          "assets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "format": "uri" }
          }
        },
        "additionalProperties": false
      }
    },
    "decision_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "pass_signal", "route"],
        "properties": {
          "criterion": { "type": "string" },
          "pass_signal": { "type": "string" },
          "route": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "roi_drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["driver", "economic_reason", "evidence"],
        "properties": {
          "driver": { "type": "string" },
          "economic_reason": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "go_no_go_gates": {
      "type": "object",
      "required": ["go", "review_first", "no_go"],
      "properties": {
        "go": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "review_first": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "no_go": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "evidence_to_collect": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "recommended_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trigger", "path", "next_url"],
        "properties": {
          "trigger": { "type": "string" },
          "path": { "type": "string" },
          "next_url": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" }
    }
  },
  "additionalProperties": false
}
