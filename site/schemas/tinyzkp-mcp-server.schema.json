{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyzkp.com/schemas/tinyzkp-mcp-server.schema.json",
  "title": "TinyZKP MCP Server Metadata",
  "type": "object",
  "required": [
    "name",
    "url",
    "generated_at",
    "summary",
    "positioning",
    "server",
    "install",
    "recommended_agent_policy",
    "tools",
    "pricing",
    "limits",
    "related_assets",
    "contact"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "canonical_metadata": { "type": "string", "format": "uri" },
    "generated_at": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "positioning": {
      "type": "object",
      "required": ["primary_category", "best_for", "not_a_fit_by_default"],
      "properties": {
        "primary_category": { "type": "string" },
        "best_for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "not_a_fit_by_default": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "server": {
      "type": "object",
      "required": ["name", "endpoint", "transport", "authentication"],
      "properties": {
        "name": { "type": "string" },
        "endpoint": { "type": "string", "format": "uri" },
        "transport": { "type": "string" },
        "authentication": {
          "type": "object",
          "required": ["type", "header", "required_for", "not_required_for"],
          "properties": {
            "type": { "type": "string" },
            "header": { "type": "string" },
            "required_for": {
              "type": "array",
              "items": { "type": "string" }
            },
            "not_required_for": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "install": {
      "type": "object",
      "required": ["claude_code", "local_stdio"],
      "properties": {
        "claude_code": {
          "type": "object",
          "required": ["label", "command"],
          "properties": {
            "label": { "type": "string" },
            "command": { "type": "string" }
          },
          "additionalProperties": false
        },
        "local_stdio": {
          "type": "object",
          "required": ["label", "config"],
          "properties": {
            "label": { "type": "string" },
            "config": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "recommended_agent_policy": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "auth_required", "description"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "auth_required": { "type": "boolean" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "pricing": {
      "type": "object",
      "required": ["verification", "free_plan", "self_serve_plans", "machine_readable_pricing"],
      "properties": {
        "verification": { "type": "string" },
        "free_plan": { "type": "string" },
        "self_serve_plans": {
          "type": "array",
          "items": { "type": "string" }
        },
        "machine_readable_pricing": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["public_verification", "proving", "spend_controls"],
      "properties": {
        "public_verification": { "type": "string" },
        "proving": { "type": "string" },
        "spend_controls": { "type": "string" }
      },
      "additionalProperties": false
    },
    "related_assets": {
      "type": "object",
      "required": [
        "llms",
        "openapi",
        "docs",
        "recipes",
        "agent_guide",
        "receipt_schema",
        "agent_receipt_schema",
        "pricing_metadata",
        "discovery_metadata",
        "security_review",
        "status"
      ],
      "additionalProperties": { "type": "string", "format": "uri" }
    },
    "contact": {
      "type": "object",
      "required": ["support", "security", "sales"],
      "properties": {
        "support": { "type": "string" },
        "security": { "type": "string" },
        "sales": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
