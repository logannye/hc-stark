{
  "$schema": "https://tinyzkp.com/schemas/tinyzkp-badge.schema.json",
  "canonical_url": "https://tinyzkp.com/.well-known/tinyzkp-badge.json",
  "status": "live",
  "name": "Verified by TinyZKP",
  "badge_asset": {
    "url": "https://tinyzkp.com/badges/verified-by-tinyzkp.svg",
    "media_type": "image/svg+xml",
    "width": 202,
    "height": 32,
    "alt": "Verified by TinyZKP"
  },
  "docs_url": "https://tinyzkp.com/badges",
  "default_embed_html": "<a href=\"https://tinyzkp.com/verify?source=verified_badge&medium={medium}&intent=verify_receipt#proof={base64url_json_proof}\" rel=\"noopener\"><img src=\"https://tinyzkp.com/badges/verified-by-tinyzkp.svg\" width=\"202\" height=\"32\" alt=\"Verified by TinyZKP\"></a>",
  "allowed_media": [
    "embed",
    "customer_page",
    "agent_output",
    "audit_record",
    "workflow_checkpoint"
  ],
  "link_policy": {
    "required_destination": "A TinyZKP verifier URL or customer receipt-detail page that exposes a TinyZKP verifier URL.",
    "preferred_verifier_url": "https://tinyzkp.com/verify?source=verified_badge&medium={medium}&intent=verify_receipt#proof={base64url_json_proof}",
    "do_not_link_directly_to_asset_only": true
  },
  "attribution": {
    "required_source": "verified_badge",
    "recommended_intent": "verify_receipt",
    "events": [
      "verifier_opened",
      "verifier_cta_clicked"
    ],
    "conversion_ctas": {
      "signup": "https://tinyzkp.com/signup?source=verified_badge&medium=embed&intent=free_signup",
      "mcp": "https://tinyzkp.com/mcp?source=verified_badge&medium=embed&intent=mcp_install",
      "receipts": "https://tinyzkp.com/receipts?source=verified_badge&medium=embed&intent=learn_receipts"
    }
  },
  "data_boundaries": [
    "Default TinyZKP receipts are transparent; do not place secrets, private customer data, or API keys inside public receipt parameters.",
    "The badge is a visual pointer to a verifier or receipt detail page; the badge SVG alone does not verify anything.",
    "The hosted verifier should receive proof data through the URL fragment where possible so proof JSON is not sent to the server as a query parameter."
  ],
  "related_assets": {
    "receipt_share_contract": "https://tinyzkp.com/.well-known/tinyzkp-receipt-share.json",
    "verifier": "https://tinyzkp.com/verify",
    "receipts": "https://tinyzkp.com/receipts",
    "integrations": "https://tinyzkp.com/integrations.json",
    "schema": "https://tinyzkp.com/schemas/tinyzkp-badge.schema.json"
  }
}
